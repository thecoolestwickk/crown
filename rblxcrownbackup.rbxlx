			<Item class="Script" referent="RBXF789795A5861446D91F5AAACB3DAAE11">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local part = script.Parent

-- CONFIGURATION: Change this to match the exact name of your tool
local TOOL_NAME = "CrownTool" 

-- Debounce table to track players by UserId and prevent multiple instant triggers
local touchDebounce = {}
local RESET_TIME = 1 -- Cooldown in seconds before the part can toggle for the same player again

local function onTouched(otherPart)
	-- Look up the character hierarchy from whatever part touched the block
	local character = otherPart.Parent
	if not character then return end

	-- CRITICAL FIX: Dynamically fetch the player on the server using the character model
	local player = game.Players:GetPlayerFromCharacter(character)

	-- Ensure it was a real player who touched it, and they aren't on cooldown
	if player and not touchDebounce[player.UserId] then
		local backpack = player:FindFirstChild("Backpack")
		if not backpack then return end

		-- Find the tool inside their inventory or actively equipped in their hand
		local tool = backpack:FindFirstChild(TOOL_NAME) or character:FindFirstChild(TOOL_NAME)

		if tool then
			-- Lock player cooldown
			touchDebounce[player.UserId] = true

			-- Get current enabled status (default to true if nil)
			local currentStatus = tool:GetAttribute("Enabled")
			if currentStatus == nil then currentStatus = true end

			-- Toggle the boolean state
			local newStatus = not currentStatus
			tool:SetAttribute("Enabled", newStatus)

			-- Optional visual feedback: Flash the block color
			local originalColor = part.Color
			part.Color = newStatus and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)

			task.delay(0.3, function()
				part.Color = originalColor
			end)

			-- Release the debounce lock after the cooldown time passes
			task.wait(RESET_TIME)
			touchDebounce[player.UserId] = nil
		end
	end
end

part.Touched:Connect(onTouched)
]]></ProtectedString>
