				<Properties>
					<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local HintEvent = ReplicatedStorage:WaitForChild("CrownEvents"):WaitForChild("HintEvent")
part = script.Parent

local isCooldown = false

part.Touched:Connect(function(hit)
	local character = hit.Parent
	local player = Players:GetPlayerFromCharacter(character)

	if player and not isCooldown then
		isCooldown = true

		HintEvent:FireAllClients("bro go away i was sleeping", {
			shake = true, 
			typewriter = true,
			textcolor = Color3.fromRGB(255, 0, 0)
		})

		task.wait(5) -- Cooldown matches or slightly exceeds the hint duration
		isCooldown = false
	end
end)
]]></ProtectedString>
